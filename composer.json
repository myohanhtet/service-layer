{
    "name": "myohanhtet/service-layer",
    "description": "A Laravel package to generate service layer files",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Myohanhtet\\ServiceLayer\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Myo Han Htet",
            "email": "myohanhtet.ly@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/console": "^12.10",
        "illuminate/support": "^12.10"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Myohanhtet\\ServiceLayer\\ServiceLayerServiceProvider"
            ],
            "aliases": {
                "ServiceLayer": "Myohanhtet\\ServiceLayer\\Facades\\ServiceLayer"
            }
        }
    }
}
